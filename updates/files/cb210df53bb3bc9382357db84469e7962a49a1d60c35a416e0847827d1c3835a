test('a drawn line changes its thickness from its menu; players and objects keep their menus',()=>{
  const {app,calls}=tab();
  const counts={refresh:0,halo:0,changed:0};
  const line={_shapeKey:'line',_parameters:{strokeWidth:2},refresh(){counts.refresh++;},_addShadowContainer(){counts.halo++;},_events:{shapeChanged(){counts.changed++;}}};
  app.ui.showContextMenu({position:'mouse',event:{currentTarget:{ShapeObject:line}},items:[{role:'button',text:'Удалить'}]});
  const menu=calls.menus.at(-1);
  assert.equal(menu.position,'mouse');assert.equal(menu.items.length,2);assert.equal(menu.items[0].role,'element');assert.equal(menu.items[1].text,'Удалить');
  const picker=menu.items[0].element;
