  picker.listeners.click[0]({target:{closest:()=>({dataset:{width:'4'}})}});
  assert.equal(line._parameters.strokeWidth,4);assert.deepEqual({...counts},{refresh:1,halo:1,changed:1});
  for(const currentTarget of [{ShapeObject:{_shapeKey:'goal-a-m',_parameters:{}}},{ElementObject:{}}]){
    app.ui.showContextMenu({event:{currentTarget},items:[{role:'button'}]});assert.equal(calls.menus.at(-1).items.length,1);
  }
});
test('an emoji player keeps its number on a small badge in the team color',()=>{
  const {drawing,observers}=tab();
  class Figure{
    constructor(options){this._elementContainerID=options.elementContainerID;this._elementContainers=options.elementContainers;this._elementParts=['selection','shape','name','number','border'];}
    get size(){return 28;}get figureView(){return this._figureView;}get elementParts(){return [...this._elementParts];}
  }
  assert.equal(drawing.emojiFigure('circle',Figure,{}),null);assert.equal(drawing.emojiFigure(undefined,Figure,{}),null);
  const parts={},figure=drawing.emojiFigure('emoji:⚽',Figure,{elementContainerID:'main_player_1_1',elementContainers:parts});
  assert.ok(figure instanceof Figure);assert.equal(figure.figureView,'emoji:⚽');
  assert.equal(figure.elementParts.join(),'selection,emoji,shape,name,number,border');
  const emoji=figure.getEmojiContainer();
  assert.equal(emoji.textContent,'⚽');assert.equal(emoji.id,'main_player_1_1_emoji');assert.match(emoji.style.fontFamily,/Segoe UI Emoji/);
  Object.assign(parts,{emoji,shape:element('circle'),border:element('circle'),number:element('text')});
  figure._setSize();
  assert.equal(emoji.getAttribute('font-size'),'34');
  assert.equal(parts.shape.getAttribute('cx'),String(28*.4));assert.equal(parts.number.getAttribute('x'),String(28*.4));
  // Without a number the emoji stands alone; the badge comes back with it.
  assert.ok(parts.shape.hasAttribute('hidden'));assert.ok(parts.border.hasAttribute('hidden'));
  parts.number.textContent='7';observers.forEach(callback=>callback());
  assert.ok(!parts.shape.hasAttribute('hidden'));assert.ok(!parts.border.hasAttribute('hidden'));
  parts.border.setAttribute('stroke-width','3');figure._setColor('#ff0000');assert.equal(parts.border.getAttribute('stroke-width'),'1');
  figure._processRotate(45);assert.equal(emoji.getAttribute('transform'),'rotate(45)');
  figure._cancelRotation();assert.equal(emoji.getAttribute('transform'),'rotate(0)');
  assert.equal(emoji.getAttribute('fill'),null);
});
