test('the view menu offers an emoji, applies a typed one and remembers it',()=>{
  const {app,calls,modalInput,local}=tab();
  const chosen=[];
  const picker=new app.ui.PlayerViewPicker({options:['circle','camiseta','triangle','rectangle'],defaultValue:'emoji:⚽',onSelect:view=>chosen.push(view)});
  // The original picker never sees a view it cannot draw.
  assert.equal(calls.picker.defaultValue,'circle');
  const items=picker.elementContainer.children,button=items.at(-1);
  assert.ok(!items[0].classList.contains('selected'));assert.equal(button.className,'emoji selected');assert.equal(button.textContent,'⚽');
  button.listeners.click[0]();
  assert.equal(calls.hidden,1);assert.match(calls.modal.content,/data-emoji="⚽" data-not-submit-by-enter-key="1" class="emoji-current"/);
  modalInput.value='мяч 🥅';calls.modal.onOk();
  assert.equal(chosen.join(),'emoji:🥅');assert.equal(local.getItem('tactical-board.recent-emoji'),'["🥅"]');
  modalInput.value='без эмодзи';calls.modal.onOk();
  assert.equal(chosen.length,1);assert.equal(calls.notifications.join(),'warning');
  const plain=new app.ui.PlayerViewPicker({options:['circle','camiseta'],defaultValue:'triangle',onSelect(){}}),add=plain.elementContainer.children.at(-1);
  assert.equal(calls.picker.defaultValue,'triangle');assert.equal(add.className,'emoji');assert.equal(add.textContent,'🙂');
  add.listeners.click[0]();assert.match(calls.modal.content,/<h3>Недавние<\/h3><div class="emoji-list"><button type="button" data-emoji="🥅"/);
  // The symbols come first, even before the recent ones; ✘ leads them.
  assert.deepEqual([...calls.modal.content.matchAll(/<h3>([^<]+)<\/h3>/g)].map(match=>match[1]),['Символы','Недавние','Футбол','Люди','Животные','Знаки']);
  assert.match(calls.modal.content,/<h3>Символы<\/h3><div class="emoji-list"><button type="button" data-emoji="✘" data-not-submit-by-enter-key="1" class="emoji-symbol">/);
  modalInput.value='✘';calls.modal.onOk();assert.equal(local.getItem('tactical-board.recent-emoji'),'["✘","🥅"]');
  const cross=new app.ui.PlayerViewPicker({options:['circle'],defaultValue:'emoji:✘',onSelect(){}});
  assert.equal(cross.elementContainer.children.at(-1).className,'emoji symbol selected');
});
