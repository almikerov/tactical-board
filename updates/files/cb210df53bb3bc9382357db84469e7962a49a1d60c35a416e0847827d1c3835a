function memory(data=new Map()){return {data,getItem:key=>data.has(key)?data.get(key):null,setItem:(key,value)=>data.set(key,String(value)),removeItem:key=>data.delete(key)};}
function element(tag='div'){
  const classes=new Set();
  return {tagName:tag,children:[],dataset:{},attributes:{},listeners:{},style:{setProperty(key,value){this[key]=value;}},textContent:'',title:'',innerHTML:'',
    get className(){return [...classes].join(' ');},set className(value){classes.clear();for(const name of String(value).split(' ').filter(Boolean))classes.add(name);},
    classList:{add:name=>classes.add(name),remove:name=>classes.delete(name),contains:name=>classes.has(name),toggle:(name,on)=>on?classes.add(name):classes.delete(name)},
    setAttribute(key,value){this.attributes[key]=String(value);},getAttribute(key){return key in this.attributes?this.attributes[key]:null;},
    hasAttribute(key){return key in this.attributes;},toggleAttribute(key,on){if(on)this.attributes[key]='';else delete this.attributes[key];return on;},
    addEventListener(type,listener){(this.listeners[type]||=[]).push(listener);},appendChild(child){this.children.push(child);return child;},querySelectorAll(){return [];}};
}
function tab({local=memory()}={}){
  const calls={menus:[],dropdowns:[],settings:[],notifications:[],hidden:0,modal:null,picker:null};
  const nodes=new Map(),observers=[],modalInput={value:''};
  for(const page of ['main','animation']){const lineEnd=element();lineEnd.after=node=>nodes.set(node.id,node);nodes.set(page+'_shapes_manager_line_end_style',lineEnd);}
  // The original picker: one item per view, the default one selected.
  function Picker(options){
    calls.picker=options;
    const container=element();
    for(const view of options.options){const item=element();item.className=view===options.defaultValue?view+' selected':view;container.appendChild(item);}
    container.querySelectorAll=selector=>selector==='.selected'?container.children.filter(item=>item.classList.contains('selected')):[];
    Object.defineProperty(this,'elementContainer',{get:()=>container});
  }
  const manager=page=>({set:value=>calls.settings.push([page,value])});
  const app={
    pages:{_pages:{main:{_shapesManager:manager('main')},animation:{_shapesManager:manager('animation')}}},
    layout:{async _initApplication(){return 'started';}},
    ui:{showContextMenu(options){calls.menus.push(options);},PlayerViewPicker:Picker,
      DropdownButtons:function(target,options){calls.dropdowns.push({target,options});target.UIDropdownButtonsObject=this;},
      showModalWindow(options){calls.modal=options;},closeModalWindow(){},hideContextMenu(){calls.hidden++;},notification(text,type){calls.notifications.push(type);}},
  };
  const document={createElement:tag=>element(tag),createElementNS:(ns,tag)=>element(tag),getElementById:id=>nodes.get(id)||null,
    querySelector:selector=>selector.includes('emoji-input')?modalInput:null,isTouchable:false};
  const context=vm.createContext({TacticalLocal:app,document,localStorage:local,MutationObserver:class{constructor(callback){observers.push(callback);}observe(){}}});
  context.window=context;
  vm.runInContext(source,context);
  return {app,calls,nodes,observers,modalInput,local,drawing:context.TacticalDrawing};
}

