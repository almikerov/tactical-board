test('any emoji in a text becomes a player icon, letters and digits do not',()=>{
  const {drawing}=tab();
  for(const [text,emoji] of [['⚽','⚽'],['игрок ⚽ номер 10','⚽'],['☀','☀️'],['❤️','❤️'],['🏃‍♀️','🏃‍♀️'],['👍🏽','👍🏽'],['1️⃣','1️⃣'],['🇷🇺','🇷🇺'],['🏴󠁧󠁢󠁳󠁣󠁴󠁿','🏴󠁧󠁢󠁳󠁣󠁴󠁿'],['👨‍👩‍👧‍👦','👨‍👩‍👧‍👦']])
    assert.equal(drawing.cleanEmoji(text),emoji,text);
  // Plain symbols stay letters: no emoji selector is added to them.
  for(const [text,symbol] of [['✘','✘'],['⚽︎','⚽︎'],['◉','◉'],['⍙','⍙'],['●','●'],['•','•'],['◎ ○','◎'],['счёт ×','×']])
    assert.equal(drawing.cleanEmoji(text),symbol,text);
  for(const text of ['7','#','+','<','abc','',null,undefined,Array(12).fill('👨').join('‍')])assert.equal(drawing.cleanEmoji(text),null,String(text));
  assert.equal(drawing.emojiOf('emoji:⚽'),'⚽');assert.equal(drawing.emojiOf('emoji:☀'),'☀️');
  for(const view of ['circle','camiseta','emoji:','emoji:abc',undefined,42])assert.equal(drawing.emojiOf(view),null,String(view));
});
