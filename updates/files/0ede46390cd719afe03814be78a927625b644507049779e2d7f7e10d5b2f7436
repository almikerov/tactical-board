test('collection data is persisted and opens via its own route',async()=>{
  const input={name:'Тестовая схема',description:'Сохранение',board:'big-football-half',page:'main',data:{players:{},shapes:[]}};
  const r=await post('/local/items',input);assert.equal(r.status,201);const item=await r.json();
  const items=await (await fetch(base+'/local/items')).json();assert.equal(items[0].id,item.id);
  const disk=JSON.parse(await readFile(path.join(dataDir,'library.json'),'utf8'));assert.equal(disk.items[0].name,input.name);
  const html=await (await fetch(base+'/'+item.id)).text();assert.ok(html.includes("id='input_param__board_key'>big-football-half"));
});
test('rejects invalid import and foreign-origin writes',async()=>{
  assert.equal((await post('/local/items',{name:'invalid'})).status,400);
  assert.equal((await fetch(base+'/local/items',{method:'POST',headers:{Origin:'https://unrelated.example','Content-Type':'application/json'},body:'{}'})).status,403);
});
test('deleting a collection entry persists, invalidates its link, and preserves other entries',async()=>{
  const keep=await (await post('/local/items',{name:'Keep',board:'big-football',page:'main',data:{players:{}}})).json();
  const remove=await (await post('/local/items',{name:'Delete test',board:'big-football',page:'animation',data:{frames:[]}})).json();
  const url=base+'/local/items/'+remove.id;
  assert.equal((await fetch(url,{method:'DELETE',headers:{Origin:'https://unrelated.example'}})).status,403);
  assert.deepEqual(await (await fetch(url,{method:'DELETE'})).json(),{deleted:remove.id});
  const items=await (await fetch(base+'/local/items')).json();assert.ok(items.some(i=>i.id===keep.id));assert.ok(!items.some(i=>i.id===remove.id));
  const disk=JSON.parse(await readFile(path.join(dataDir,'library.json'),'utf8'));assert.ok(!disk.items.some(i=>i.id===remove.id));assert.equal(disk.links[remove.id],undefined);assert.ok(disk.links[keep.id]);
  assert.equal((await fetch(base+'/animation/'+remove.id)).status,404);assert.equal((await fetch(url,{method:'DELETE'})).status,404);
  assert.equal((await fetch(base+'/'+keep.id)).status,200);
});
test('unknown routes and private source files are not served',async()=>{
  for(const route of ['/server.mjs','/data/library.json','/unknown'])assert.equal((await fetch(base+route)).status,404);
});
test('editing collection metadata preserves the drawing, route, creation date and other records',async()=>{
  const original=await (await post('/local/items',{name:'Атака',description:'Исходное',categories:' Угловые, Прессинг, Угловые, ',board:'big-football-half',page:'main',data:{players:{p1:{x:0.4}}}})).json();
  assert.deepEqual(original.categories,['Угловые','Прессинг']);
  const url=base+'/local/items/'+original.id;
  const patch=value=>fetch(url,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify(value)});
  assert.equal((await patch({name:' '})).status,400);
  const edited=await (await patch({name:' Защита <1> ',description:'Описание & детали',categories:[' Стандарты ','Стандарты','']})).json();
  assert.equal(edited.name,'Защита <1>');assert.deepEqual(edited.categories,['Стандарты']);
  assert.deepEqual(edited.data,original.data);assert.equal(edited.created,original.created);assert.equal(edited.board,original.board);
  const disk=JSON.parse(await readFile(path.join(dataDir,'library.json'),'utf8'));
  assert.deepEqual(disk.items.find(i=>i.id===original.id),edited);assert.deepEqual(disk.links[original.id].data,original.data);
  assert.equal((await fetch(base+'/'+original.id)).status,200);
  assert.equal((await fetch(url,{method:'PATCH',headers:{Origin:'https://unrelated.example'}})).status,403);
});
test('collection accepts additional schemes beyond both original limits (10 and 1002)',async()=>{
  const dir=await mkdtemp(path.join(tmpdir(),'tactical-board-large-'));
  const items=Array.from({length:1003},(_,n)=>({id:'fixture-'+n,name:'Схема '+n,page:'main',board:'big-football',data:{players:{}},created:new Date().toISOString()}));
  await writeFile(path.join(dir,'library.json'),JSON.stringify({items,links:{}}));
  const process2=spawn(process.execPath,['server.mjs'],{cwd:root,env:{...process.env,PORT:'0',TB_DATA_DIR:dir},stdio:['ignore','pipe','pipe']});
  try{
    const address=await new Promise((resolve,reject)=>{process2.stdout.on('data',b=>{const m=b.toString().match(/http:\/\/127\.0\.0\.1:\d+/);if(m)resolve(m[0]);});process2.on('error',reject);process2.on('exit',code=>reject(Error('Server exited: '+code)));});
    const r=await fetch(address+'/local/items',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:'Схема 1004',page:'main',board:'big-football',data:{players:{}}})});
    assert.equal(r.status,201);assert.equal((await (await fetch(address+'/local/items')).json()).length,1004);
  }finally{process2.kill();}
});
