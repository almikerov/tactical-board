import {test,after} from 'node:test';
import assert from 'node:assert/strict';
import http from 'node:http';
import {spawn} from 'node:child_process';
import {mkdtemp,readFile,writeFile,cp,mkdir,access} from 'node:fs/promises';
import {createHash} from 'node:crypto';
import {tmpdir} from 'node:os';
import path from 'node:path';
import {fileURLToPath} from 'node:url';
import {updatable,newer} from '../updater.mjs';
const root=path.dirname(path.dirname(fileURLToPath(import.meta.url)));
const sha=bytes=>createHash('sha256').update(bytes).digest('hex');
const children=[],hosts=[];
after(()=>{for(const child of children)child.kill();for(const host of hosts)host.close();});

// A copy of the app with a collection in its own data folder, as a user has it.
async function install(){
  const dir=await mkdtemp(path.join(tmpdir(),'tactical-board-update-'));
  for(const name of ['server.mjs','conference.mjs','updater.mjs','package.json','public','templates'])await cp(path.join(root,name),path.join(dir,name),{recursive:true});
  await mkdir(path.join(dir,'data'));await cp(path.join(root,'data/texts-ru.json'),path.join(dir,'data/texts-ru.json'));
  const library={links:{},items:[{id:'kept',name:'Моя схема',description:'',categories:[],board:'big-football',page:'main',data:{players:{},shapes:[]},created:'2026-10-01T00:00:00.000Z'}]};
  await writeFile(path.join(dir,'data/library.json'),JSON.stringify(library));
  return dir;
}
// A stand-in for GitHub Pages serving updates/latest.json and updates/files/<sha256>.
async function publish(version,files){
  const objects=new Map(),requests=[];
  const listed=Object.entries(files).map(([file,content])=>{const bytes=Buffer.from(content);objects.set(sha(bytes),bytes);return {path:file,sha256:sha(bytes),bytes:bytes.length};});
  const host=http.createServer((req,res)=>{
    requests.push(req.url.split('?')[0]);
    if(req.url.startsWith('/updates/latest.json')){res.end(JSON.stringify({version,date:'27.10.2026',notes:['Новая функция'],files:listed}));return;}
    const bytes=objects.get(req.url.slice('/updates/files/'.length));
    if(bytes){res.end(bytes);return;}
    res.writeHead(404);res.end();
  });
  hosts.push(host);
  await new Promise(resolve=>host.listen(0,'127.0.0.1',resolve));
  return {url:`http://127.0.0.1:${host.address().port}/updates/latest.json`,requests};
}
async function launch(dir,url){
  const child=spawn(process.execPath,['server.mjs'],{cwd:dir,env:{...process.env,PORT:'0',TB_UPDATE_URL:url,TB_DATA_DIR:'',TB_UPDATE_FAILED:''},stdio:['ignore','pipe','pipe']});
  children.push(child);
  const base=await new Promise((resolve,reject)=>{child.stdout.on('data',b=>{const m=b.toString().match(/http:\/\/127\.0\.0\.1:\d+/);if(m)resolve(m[0]);});child.on('exit',code=>reject(Error('Server exited: '+code)));});
  return {child,base};
}
const post=(base,route)=>fetch(base+route,{method:'POST',headers:{'Content-Type':'application/json'},body:'{}'});
async function waitFor(base,check){
  for(let i=0;i<80;i++){
    const health=await fetch(base+'/health').then(r=>r.json()).catch(()=>null);
    if(health&&check(health))return health;
    await new Promise(resolve=>setTimeout(resolve,250));
  }
  throw Error('Server did not come back');
}

test('only app files can be updated, never the collection or launchers',()=>{
  for(const file of ['server.mjs','public/local.js','templates/big-football.html','data/texts-ru.json','public/static/fonts/comic-sans-ms.2be4a49a17700938dbc0..ttf'])assert.ok(updatable(file),file);
  for(const file of ['data/library.json','START.cmd','launch.mjs','runtime/darwin-arm64/node','../server.mjs','public/../../x','/etc/passwd','public//x','.update/installed.json','C:/x'])assert.ok(!updatable(file),file);
  assert.ok(newer('1.10.0','1.9.9'));assert.ok(newer('2.0.0','1.99.99'));assert.ok(!newer('1.4.0','1.4.0'));assert.ok(!newer('1.3.9','1.4.0'));
});

test('an update downloads what changed, restarts and keeps the collection',async()=>{
  const dir=await install();
  const libraryBefore=await readFile(path.join(dir,'data/library.json'),'utf8');
  const pkg=JSON.parse(await readFile(path.join(dir,'package.json'),'utf8'));
  const host=await publish('99.0.0',{
    'package.json':JSON.stringify({...pkg,version:'99.0.0'}),
    'public/added.txt':'новый файл',
    'server.mjs':await readFile(path.join(dir,'server.mjs')),
  });
  const {base}=await launch(dir,host.url);
  const info=await (await fetch(base+'/local/update')).json();
  assert.equal(info.current,pkg.version);assert.equal(info.available,true);assert.equal(info.latest.version,'99.0.0');assert.deepEqual(info.latest.notes,['Новая функция']);
  assert.equal((await post(base,'/local/update/later')).status,200);
  assert.equal((await (await fetch(base+'/local/update')).json()).dismissed,true);

  const result=await (await post(base,'/local/update/apply')).json();
  assert.deepEqual(result,{version:'99.0.0',files:2});
  // Unchanged files are not downloaded again.
  assert.equal(host.requests.filter(url=>url.startsWith('/updates/files/')).length,2);
  await waitFor(base,health=>health.version==='99.0.0');
  assert.equal(await readFile(path.join(dir,'data/library.json'),'utf8'),libraryBefore);
  assert.deepEqual((await (await fetch(base+'/local/items')).json()).map(item=>item.name),['Моя схема']);
  assert.equal(await readFile(path.join(dir,'public/added.txt'),'utf8'),'новый файл');
  const now=await (await fetch(base+'/local/update')).json();
  assert.equal(now.current,'99.0.0');assert.equal(now.available,false);assert.equal(now.dismissed,false);
});

test('a version that does not start is rolled back automatically',async()=>{
  const dir=await install();
  const serverBefore=await readFile(path.join(dir,'server.mjs'),'utf8'),pkgBefore=await readFile(path.join(dir,'package.json'),'utf8');
  const version=JSON.parse(pkgBefore).version;
  const host=await publish('99.1.0',{
    'package.json':JSON.stringify({...JSON.parse(pkgBefore),version:'99.1.0'}),
    'server.mjs':'throw Error("broken release");\n',
    'public/only-in-broken.txt':'x',
  });
  const {base}=await launch(dir,host.url);
  assert.equal((await post(base,'/local/update/apply')).status,200);
  // The restored server reports which version failed.
  let info=null;
  for(let i=0;i<80&&info?.failed!=='99.1.0';i++){await new Promise(resolve=>setTimeout(resolve,250));info=await fetch(base+'/local/update').then(r=>r.json()).catch(()=>null);}
  assert.equal((await (await fetch(base+'/health')).json()).version,version);
  assert.equal(info.failed,'99.1.0');assert.equal(info.current,version);
  assert.equal(await readFile(path.join(dir,'server.mjs'),'utf8'),serverBefore);
  assert.equal(await readFile(path.join(dir,'package.json'),'utf8'),pkgBefore);
  await assert.rejects(access(path.join(dir,'public/only-in-broken.txt')));
});

test('a damaged download changes nothing',async()=>{
  const dir=await install();
  const host=await publish('99.2.0',{'package.json':'{}'});
  const {base}=await launch(dir,host.url);
  // The host now serves bytes that do not match the published checksum.
  hosts.at(-1).removeAllListeners('request');
  hosts.at(-1).on('request',(req,res)=>{
    if(req.url.startsWith('/updates/latest.json')){res.end(JSON.stringify({version:'99.2.0',files:[{path:'package.json',sha256:sha(Buffer.from('{}')),bytes:2}]}));return;}
    res.end('{x');
  });
  const response=await post(base,'/local/update/apply');
  assert.equal(response.status,400);assert.match((await response.json()).error,/повреждён/);
  assert.equal(JSON.parse(await readFile(path.join(dir,'package.json'),'utf8')).name,'tactical-board-local');
  assert.equal((await (await fetch(base+'/health')).json()).ok,true);
});
